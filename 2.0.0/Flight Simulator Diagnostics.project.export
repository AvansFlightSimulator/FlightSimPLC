                <Single Name="Id" Type="long">3367</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">// Run when connection is active.</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3368</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">IF fbTcpClient.xActive AND GVL.FlightSimulator.isInitialised() THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3369</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    DriveDiagnostics();</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3370</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    diagnosticSendTimer(IN := NOT xWrite, PT := T#50MS);</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3371</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    IF fbTcpWrite.xDone OR fbTcpWrite.xError THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3372</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        xWrite := FALSE;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3373</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    ELSIF NOT fbTcpWrite.xBusy AND diagnosticSendTimer.Q THEN</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3374</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        sent := BuildDiagnosticFeedback();</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3375</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        xWrite := LEN(sent) &gt; 0;</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3376</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        IF NOT xWrite THEN diagnosticBuildErrors := diagnosticBuildErrors + 1; END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3377</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    END_IF</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3378</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // Buffer remains unchanged while TCP_Write is busy. Send only meaningful</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3379</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    // bytes (including the newline), never the unused NUL-filled capacity.</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3380</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">    fbTcpWrite(xExecute := xWrite, hConnection := fbTcpClient.hConnection,</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
                <Single Name="Id" Type="long">3381</Single>
                <Null Name="Tag" />
                <Single Name="Text" Type="string">        udiTimeOut := udiTimeOut, szSize := INT_TO_UDINT(LEN(sent)), pData := ADR(sent));</Single>
              </Single>
              <Single Type="{a5de0b0b-1cb5-4913-ac21-9d70293ec00d}" Method="IArchivable">
